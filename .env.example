# Copy this file to '.env' if you integrate external serverless APIs.
# DO NOT commit real secrets, private tokens, or credentials to Git!

# Site URL (for production canonical links & OG metadata)
SITE_URL=https://lokeshvaishnav.vercel.app

# Optional: Contact Form Endpoint / API Service (e.g. Web3Forms, Formspree, EmailJS)
# WEB3FORMS_ACCESS_KEY=your_access_key_here
# FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# Optional: Google Analytics / Search Console verification ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# GOOGLE_SITE_VERIFICATION=your_google_search_console_token
